# InvenXis - Environment Variables
# Copy this file to .env and adjust values

# Django Security
SECRET_KEY=django-insecure-change-this-in-production-generate-with-python-c-django-core-management-utils-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database - SQLite (development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Database - PostgreSQL (production / docker-compose)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=invenxis
# DB_USER=invenxis
# DB_PASSWORD=change-me
# DB_HOST=db
# DB_PORT=5432

# Cache (production / docker-compose)
# REDIS_URL=redis://localhost:6379/0

# Database - MySQL (production - Laragon)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=inventario_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# DB_OPTIONS={"charset": "utf8mb4"}

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# CORS (for mobile/frontend development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=True

# Static/Media
STATIC_URL=/static/
MEDIA_URL=/media/

# Logging
LOG_LEVEL=INFO